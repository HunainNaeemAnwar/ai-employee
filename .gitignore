# ===========================================
# Vault Secrets (NEVER COMMIT)
# ===========================================
AI_Employee_Vault/.system/
AI_Employee_Vault/SECURITY/

# ===========================================
# Vault State (regenerated)
# ===========================================
AI_Employee_Vault/.system/state/current_task.json
AI_Employee_Vault/.system/state/seen_email_ids.json
AI_Employee_Vault/.system/state/*.json

# ===========================================
# Vault Processing & Logs
# ===========================================
AI_Employee_Vault/PROCESSING/
AI_Employee_Vault/Logs/*.jsonl
AI_Employee_Vault/Logs/*.log

# ===========================================
# Vault Obsidian User State
# ===========================================
AI_Employee_Vault/.obsidian/workspace.json
AI_Employee_Vault/.obsidian/workspace-mobile.json
AI_Employee_Vault/.obsidian/appearance.json
AI_Employee_Vault/.obsidian/graph.json

# ===========================================
# Vault Symlinks (don't track symlinks)
# ===========================================
AI_Employee_Vault/Inbox
AI_Employee_Vault/Needs_Action
AI_Employee_Vault/Done
AI_Employee_Vault/Logs

