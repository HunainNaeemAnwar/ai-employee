# AI Employee Vault - Git Ignore Rules

# ===========================================
# NEVER COMMIT - Secrets & Credentials
# ===========================================
.system/credentials.json
.system/*.json
.system/gmail_token.json
.system/*.env
.system/*.key
.system/*.pem
.system/*.crt

# ===========================================
# OAuth & API Tokens
# ===========================================
.system/oauth_tokens.json
.system/access_tokens.json
.system/api_keys.json
.system/secrets.json

# ===========================================
# Runtime State (regenerated)
# ===========================================
.system/state/current_task.json
.system/state/seen_email_ids.json
.system/state/*.json
.system/prompt.md
.system/state/complete.flag

# ===========================================
# Processing & Temporary Files
# ===========================================
PROCESSING/
*.tmp
*.bak
*~

# ===========================================
# Logs (optional - commit audit logs if needed)
# ===========================================
Logs/*.jsonl
Logs/*.log
*.log

# ===========================================
# Obsidian User Data (optional)
# ===========================================
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/appearance.json
.obsidian/graph.json

# ===========================================
# OS Files
# ===========================================
.DS_Store
Thumbs.db
desktop.ini
