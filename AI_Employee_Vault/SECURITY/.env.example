# AI Employee - Environment Variables
# NEVER commit this file to Git
# chmod 600 .env

# ===========================================
# Gmail API Credentials
# ===========================================
# Get from: https://console.cloud.google.com/
# Enable Gmail API, create OAuth2 credentials (Desktop app)

GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:8080

# ===========================================
# WhatsApp (Playwright - Local Session)
# ===========================================
# Session stored locally, never synced
# No credentials needed - uses QR code auth

# ===========================================
# Bank API (Gold Tier)
# ===========================================
# BANK_API_KEY=your_bank_api_key
# BANK_API_SECRET=your_bank_api_secret

# ===========================================
# Odoo (Gold Tier)
# ===========================================
# ODOO_URL=https://your-instance.odoo.com
# ODOO_DATABASE=your_database
# ODOO_USERNAME=your_username
# ODOO_PASSWORD=your_password

# ===========================================
# Social Media (Gold/Platinum Tier)
# ===========================================
# LINKEDIN_ACCESS_TOKEN=your_token
# TWITTER_API_KEY=your_key
# TWITTER_API_SECRET=your_secret
# INSTAGRAM_ACCESS_TOKEN=your_token

# ===========================================
# System Configuration
# ===========================================
VAULT_PATH=/home/hunain/personal_assistant/AI_Employee_Vault
LOG_LEVEL=INFO
MAX_ITERATIONS=50
